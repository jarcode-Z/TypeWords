# 方案 B：本机已 pnpm generate + sync-selfhost-assets 后，仅打包静态文件
# 构建：docker build --platform linux/amd64 -f Dockerfile.static -t typewords:local .
FROM nginx:alpine

COPY nginx.static.conf /etc/nginx/conf.d/default.conf
COPY apps/nuxt/.output/public /usr/share/nginx/html
COPY selfhost/files /usr/share/nginx/html/files
COPY selfhost/libs /usr/share/nginx/html/libs

# macOS 同步下来的目录常为 700/750，nginx 用户读不到会 404，前端表现为 JSON/JS 解析失败
RUN chmod -R a+rX /usr/share/nginx/html/files /usr/share/nginx/html/libs

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
